{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karaoke Pro",
  "version": "1.8.1",
  "identifier": "com.karaokepro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Karaoke Pro",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": false,
        "titleBarStyle": "default"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Karaoke Pro",
    "category": "Music",
    "copyright": "© 2026 Karaoke Pro. All rights reserved.",
    "longDescription": "Karaoke Pro is a feature-rich desktop karaoke application with YouTube streaming, Party mode, Peer-to-Peer connectivity, local media support, and more. Sing along to millions of songs, record your performances, and share with friends.",
    "shortDescription": "Professional desktop karaoke application",
    "homepage": "https://github.com/Duck-dev-05/desktopkaraokefinal",
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "tsp": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "template": null,
        "customLanguageFiles": null,
        "installerHooks": "installer-hooks.nsh",
        "downloadUrl": null,
        "appId": "com.karaokepro.app",
        "installMode": "perMachine",
        "allowElevation": true,
        "allowDowngrades": false,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "perMachineInstall": true,
        "runAfterFinish": true,
        "deleteAppDataOnUninstall": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "license": null,
        "headerImage": null,
        "sidebarImage": null,
        "dialogImage": null,
        "compressionLevel": "ultra"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "hardenedRuntime": false,
      "dmg": {
        "background": null,
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 430,
          "y": 170
        },
        "appstoreConnectApiKey": null,
        "appstoreConnectApiIssuer": null
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "externalBin": []
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFNkEwQ0E5Mzg0NTVCQjcKUldTM1cwVTRxUXhxdmpWNXBlOGlYY2xHMFdsdW5uMkRHdldpbkZQK1MxUzVpazFnUXpQZ013MnAK",
      "endpoints": [
        "https://github.com/Duck-dev-05/desktopkaraokefinal/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "headers": {
        "Accept": "application/json"
      }
    }
  }
}
