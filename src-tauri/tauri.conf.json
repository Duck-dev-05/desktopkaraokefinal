{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karaoke Pro",
  "version": "1.0.0",
  "identifier": "com.karaokepro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Karaoke Pro",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "copyright": "© 2026 Karaoke Pro. All rights reserved.",
    "longDescription": "Karaoke Pro is a feature-rich desktop karaoke application with YouTube streaming, Party mode, Peer-to-Peer connectivity, local media support, and more.",
    "homepage": "https://github.com/Duck-dev-05/desktopkaraokefinal",
    "windows": {
      "minimumWebview2Version": "2.0.0",
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": null,
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "libappindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "gtk3",
          "webkit2gtk4.1"
        ]
      }
    },
    "externalBin": [
      "ffmpeg",
      "yt-dlp"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFNkEwQ0E5Mzg0NTVCQjcKUldTM1cwVTRxUXhxdmpWNXBlOGlYY2xHMFdsdW5uMkRHdldpbkZQK1MxUzVpazFnUXpQZ013MnAK",
      "endpoints": [
        "https://github.com/Duck-dev-05/desktopkaraokefinal/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
